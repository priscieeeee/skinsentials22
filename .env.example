# Copy to .env and fill in. Never commit .env.
PORT=3000
# Public address of the site (used for the Paystack return link). No trailing slash.
SITE_URL=https://www.yourdomain.com
# Password for the admin dashboard (#admin). Make it long and unique.
ADMIN_PASSWORD=change-me-to-a-long-random-phrase
# Paystack SECRET key (sk_test_... to try, sk_live_... to go live). Optional: you can paste it in Admin > Settings instead.
# Leave blank to keep card / pay-with-bank / USSD / instant transfer off until a key is added. A key here overrides the dashboard.
PAYSTACK_SECRET_KEY=
# Optional: random string to sign login tokens. If blank, one is generated and kept in data/.secret
JWT_SECRET=
# Set to 1 when behind a proxy/host that sets X-Forwarded-For (Render, Railway, Nginx...) so rate limits see real IPs.
TRUST_PROXY=1
# Optional: only if the website is hosted on a DIFFERENT domain from this API.
CORS_ORIGIN=
# Optional: folder for the database (point at a persistent disk in production).
DATA_DIR=
# Optional: largest single upload in MB (videos, logos, images). Blank or 0 = no limit set by the site.
MAX_UPLOAD_MB=

# --- Optional: order and payment alerts to your phone ---
# Telegram: create a bot with @BotFather, send it a message, then put its token and your chat id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (Resend.com): alerts to you, receipts and password-reset emails to customers
RESEND_API_KEY=
MAIL_FROM=
ADMIN_EMAIL=
# Slack / Discord / any URL that accepts a JSON POST
NOTIFY_WEBHOOK_URL=
# If you ever forget the admin password you set in the dashboard: set this to 1, restart once, then remove it
RESET_ADMIN_PASSWORD=

